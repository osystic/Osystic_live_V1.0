# OSYSTIC website environment template
# Copy to .env.local for local development and provide real values privately.

# Cal.com booking path or URL, e.g. osystic/technical-call
NEXT_PUBLIC_CALCOM_BOOKING_URL=

# Optional client portal URL. Falls back to the OSYSTIC contact intake when blank.
NEXT_PUBLIC_CLIENT_PORTAL_URL=

# Database (Turso / libSQL)
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=
# Optional legacy aliases for non-Vercel deployments
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Distributed rate limiting (Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional direct Upstash aliases
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication
ADMIN_ALLOWED_EMAIL=
ADMIN_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_SIGNUP_ENABLED=false

# Optional exact origins for trusted staging frontends (comma-separated, HTTPS in production).
# Leave blank for normal same-origin production traffic.
CSRF_TRUSTED_ORIGINS=

# Email
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM=OSYSTIC <hello@osystic.com>
ADMIN_EMAIL=hello@osystic.com

# Optional integrations
CAL_API_KEY=YOUR_CAL_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
GITHUB_TOKEN=

# Automated public case-study publishing pipeline
CASE_STUDY_GITHUB_OWNER=osystic
# Long random secret. Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
